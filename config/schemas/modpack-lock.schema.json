{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "modpack-lock/1",
  "type": "object",
  "required": ["schema", "game_slug", "community", "resolved_at_utc", "packages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "modpack-lock/1" },
    "game_slug": { "type": "string" },
    "community": { "type": "string" },
    "resolved_at_utc": { "type": "string" },
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["namespace", "name", "version", "download_url", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "namespace": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "download_url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "comfort-map/1",
  "type": "object",
  "required": ["schema", "game_slug", "cfg_file", "verified_against_cfg", "map"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "comfort-map/1" },
    "game_slug": { "type": "string" },
    "cfg_file": { "type": "string" },
    "verified_against_cfg": { "type": "boolean" },
    "map": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
    }
  },
  "if": { "properties": { "verified_against_cfg": { "const": true } } },
  "then": { "properties": { "map": { "minProperties": 1 } } }
}

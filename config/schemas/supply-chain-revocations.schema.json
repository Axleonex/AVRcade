{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avrcade.local/schemas/supply-chain-revocations.schema.json",
  "title": "VRClient Supply-Chain Revocation List",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "list_id",
    "revoked_key_ids",
    "revoked_artifacts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "list_id": {
      "type": "string",
      "minLength": 1
    },
    "revoked_key_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revoked_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "reason"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

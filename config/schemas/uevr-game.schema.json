{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avrcade.local/vrclient/uevr-game.schema.json",
  "title": "VRClient UEVR Game",
  "type": "object",
  "required": [
    "schema", "game_slug", "game_id", "display_name", "steam_app_id",
    "engine", "uevr_channel", "executable_names", "executable_roles",
    "support_policy", "uevr_profile", "verification"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "uevr-game/1" },
    "game_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "game_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "steam_app_id": { "type": "string", "pattern": "^[0-9]+$" },
    "engine": { "const": "unreal" },
    "uevr_channel": { "enum": ["stable", "nightly"] },
    "executable_names": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "executable_roles": {
      "type": "object",
      "required": ["launcher_stub", "shipping_binary"],
      "additionalProperties": true,
      "properties": {
        "launcher_stub": { "type": "string", "pattern": "\\.exe$" },
        "shipping_binary": { "type": "string", "pattern": "\\.exe$" }
      }
    },
    "support_policy": {
      "type": "object",
      "required": ["anti_cheat_risk", "online_risk"],
      "additionalProperties": true,
      "properties": {
        "anti_cheat_risk": { "enum": ["none", "known_safe", "known_risky", "unknown"] },
        "online_risk": { "enum": ["offline_only", "private_modded_coop", "known_online", "unknown"] }
      }
    },
    "uevr_profile": {
      "type": "object",
      "required": ["release", "rendering_method"],
      "additionalProperties": true,
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "required_uevr_channel": { "enum": ["stable", "nightly"] },
        "rendering_method": { "type": "string", "minLength": 1 },
        "supported_builds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "required": ["repository", "revision", "profile_id", "tree_url", "license", "redistribution", "files"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "profile_id": { "type": "string", "minLength": 1 },
            "tree_url": { "type": "string", "format": "uri" },
            "license": { "enum": ["not_declared", "redistributable"] },
            "redistribution": { "enum": ["user_import_only", "direct_fetch", "checked_in"] },
            "files": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "sha256", "content_type", "disposition"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "pattern": "^[^/\\\\].*" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "content_type": { "enum": ["uevr_config", "camera_config", "imgui_config", "documentation", "metadata"] },
                  "disposition": { "enum": ["import", "inspect_only", "exclude"] }
                }
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": ["headset_stereo", "head_tracking", "gamepad", "motion_controls", "private_coop"],
          "additionalProperties": false,
          "properties": {
            "headset_stereo": { "$ref": "#/$defs/capabilityState" },
            "head_tracking": { "$ref": "#/$defs/capabilityState" },
            "gamepad": { "$ref": "#/$defs/capabilityState" },
            "motion_controls": { "$ref": "#/$defs/capabilityState" },
            "private_coop": { "$ref": "#/$defs/capabilityState" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["injection_stable", "headset_t1", "profile_status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "injection_stable": { "type": "boolean" },
        "headset_t1": { "type": "boolean" },
        "profile_status": { "enum": ["verified", "unverified"] },
        "head_bone": { "type": ["string", "null"], "deprecated": true },
        "paint_mode_property": { "type": ["string", "null"], "deprecated": true },
        "evidence": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "capabilityState": {
      "enum": ["verified", "upstream_claimed_unverified", "untested", "not_present", "unsupported", "unknown"]
    }
  }
}

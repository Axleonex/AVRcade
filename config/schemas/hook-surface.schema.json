{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avrcade.local/schemas/hook-surface.schema.json",
  "title": "VRClient Hook Surface Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "game_id",
    "build_id",
    "generated_by",
    "generated_at",
    "hooks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "area",
          "module",
          "status",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "enum": [
              "camera",
              "projection",
              "hud",
              "input",
              "interaction",
              "mode_state",
              "network_block_marker"
            ]
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "managed_method": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator_kind", "type_name", "method_name"],
            "properties": {
              "locator_kind": { "type": "string", "enum": ["mono_method", "il2cpp_method"] },
              "image": { "type": "string", "minLength": 1 },
              "type_name": { "type": "string", "minLength": 1 },
              "method_name": { "type": "string", "minLength": 1 },
              "metadata_token": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "validated",
              "blocked"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "thread_context",
              "hit_count",
              "captured_at"
            ],
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "hardware_breakpoint",
                  "vtable_observation",
                  "pass_through_detour"
                ]
              },
              "cadence_hz": {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              "per_frame": {
                "type": "boolean"
              },
              "thread_context": {
                "type": "string",
                "enum": [
                  "render",
                  "main",
                  "worker",
                  "unknown"
                ]
              },
              "hit_count": {
                "type": "integer",
                "minimum": 1
              },
              "captured_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            },
            "anyOf": [
              {
                "required": ["cadence_hz"]
              },
              {
                "required": ["per_frame"]
              }
            ]
          }
        },
        "anyOf": [
          {
            "required": ["symbol"]
          },
          {
            "required": ["signature"]
          },
          {
            "required": ["offset"]
          },
          {
            "required": ["managed_method"]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "validated"
                }
              }
            },
            "then": {
              "required": ["validation"]
            }
          },
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "required": ["blocked_reason"]
            }
          }
        ]
      }
    }
  }
}

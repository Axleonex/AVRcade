 namespace {
 
 std::atomic<bool> g_started{false};
+std::atomic<bool> g_vrActive{false};
+
+bool ReadVrActivationEnvironment() {
+    char value[8] = {};
+    const DWORD size = GetEnvironmentVariableA("VRCLIENT_VR_ACTIVE", value,
+                                               static_cast<DWORD>(sizeof(value)));
+    return size == 1 && strcmp(value, "1") == 0;
+}
+
+void WriteVrActivationBridgeState(bool active) {
+    char path[MAX_PATH] = {};
+    if (!GetModuleFileNameA(nullptr, path, MAX_PATH)) return;
+    char* slash = strrchr(path, '\\');
+    if (!slash) return;
+    *slash = '\0';
+
+    char bridgeDir[MAX_PATH] = {};
+    strcpy_s(bridgeDir, path);
+    strcat_s(bridgeDir,
+             "\\plugins\\cyber_engine_tweaks\\mods\\CyberpunkVRPort_Stereo\\bridge");
+    CreateDirectoryA(bridgeDir, nullptr);
+
+    char statePath[MAX_PATH] = {};
+    strcpy_s(statePath, bridgeDir);
+    strcat_s(statePath, "\\vrclient_vr_active.txt");
+    if (FILE* file = fopen(statePath, "w")) {
+        fputs(active ? "1\n" : "0\n", file);
+        fclose(file);
+    }
+
+    // The VRIK CET pump supplies the camera/entity pair used to keep the avatar body
+    // below and behind the HMD. Give it the same per-process contract as VRCAM so a
+    // flat launch remains completely passive while a VRClient launch cannot start
+    // with the body transform feed missing.
+    char vrikDir[MAX_PATH] = {};
+    strcpy_s(vrikDir, path);
+    strcat_s(vrikDir,
+             "\\plugins\\cyber_engine_tweaks\\mods\\CyberpunkVRPort_VRIK");
+    CreateDirectoryA(vrikDir, nullptr);
+
+    char vrikStatePath[MAX_PATH] = {};
+    strcpy_s(vrikStatePath, vrikDir);
+    strcat_s(vrikStatePath, "\\vrclient_vr_active.txt");
+    if (FILE* file = fopen(vrikStatePath, "w")) {
+        fputs(active ? "1\n" : "0\n", file);
+        fclose(file);
+    }
+}
+
+void NativeIsVRClientVrActive(RED4ext::IScriptable*, RED4ext::CStackFrame* frame,
+                              bool* out, int64_t) {
+    frame->code++;
+    if (out) *out = g_vrActive.load();
+}
+
+void PostRegisterTypes() {
+    auto rtti = RED4ext::CRTTISystem::Get();
+    RED4ext::CBaseFunction::Flags flags = {.isNative = true, .isStatic = true};
+    auto function = RED4ext::CGlobalFunction::Create("CyberpunkVRPort.NoAnims.IsVRClientVrActive",
+                                                      "IsVRClientVrActive",
+                                                      &NativeIsVRClientVrActive);
+    function->flags = flags;
+    function->SetReturnType("Bool");
+    rtti->RegisterFunction(function);
+}
 

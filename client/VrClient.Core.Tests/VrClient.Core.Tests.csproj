<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VrClient.Core\VrClient.Core.csproj" />
    <Compile Include="..\VrClient.App\Services\FalloutNewVegasDesktopService.cs" Link="Desktop\FalloutNewVegasDesktopService.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/modpacks/repo.modpack.json"
          Link="config/modpacks/repo.modpack.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../config/games/repo.json"
          Link="config/games/repo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/safety/default-rules.json"
          Link="config/safety/default-rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

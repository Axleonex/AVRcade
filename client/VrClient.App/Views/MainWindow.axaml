<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VrClient.App.ViewModels"
        xmlns:services="using:VrClient.App.Services"
        xmlns:views="using:VrClient.App.Views"
        xmlns:config="using:VrClient.Core.Config"
        xmlns:mod="using:VrClient.Core.ModManagers"
        xmlns:launch="using:VrClient.Core.Launch"
        x:Class="VrClient.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1240" Height="820" MinWidth="960" MinHeight="640"
        Background="{DynamicResource GroundBrush}"
        Foreground="{DynamicResource InkBrush}"
        Title="AVRcade">
  <Window.Resources>
    <DataTemplate x:Key="TroubleshootingCardTemplate" x:DataType="vm:TroubleshootingCardViewModel">
      <Border Classes="inset" BorderBrush="{Binding ToneBrush}" BorderThickness="4,0,0,0" Padding="20" Margin="0,0,0,12">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Label}" Foreground="{Binding ToneBrush}" FontWeight="Bold" FontSize="13" />
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary}" Classes="helpBody" />
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HelpInstruction">
                <Grid ColumnDefinitions="30,*" Margin="0,0,0,10">
                  <TextBlock Text="{Binding Number}" Foreground="{DynamicResource HelpActionBrush}" FontWeight="Bold" FontSize="16" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="helpBody" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{Binding ActionLabel}" Tag="{Binding}" IsVisible="{Binding HasAction}"
                  IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanRunGameDiagnostics}"
                  Click="TroubleshootingHelp_Click" Classes="helpAction" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="TroubleshootingStepAction" />
          <Expander Header="Technical details for this check" IsVisible="{Binding HasTechnicalDetails}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10" Margin="0,10,0,0">
              <TextBlock Text="{Binding Detail}" Classes="helpBody" />
              <TextBlock Text="{Binding OriginalInstructions}" Classes="helpBody" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
      <Grid ColumnDefinitions="Auto,Auto,20,*,16,Auto,10,Auto,10,Auto">
        <Button Content="← Library" Margin="0,0,16,0" IsVisible="{Binding ShowBack}"
                Command="{Binding BackToLibraryCommand}" />
        <TextBlock Grid.Column="1" FontSize="22" FontWeight="Bold" LetterSpacing="-0.3" VerticalAlignment="Center">
          <Run Text="A" /><Run Text="VR" Foreground="{DynamicResource AccentBrush}" /><Run Text="cade" />
        </TextBlock>
        <TextBox Grid.Column="3" MaxWidth="340" MinWidth="140" MinHeight="40" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                 IsVisible="{Binding ShowLibrary}" Watermark="Search games"
                 Text="{Binding SearchText, Mode=TwoWay}" />
        <Border Grid.Column="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="20" Padding="14,0" Height="40"
                ToolTip.Tip="{Binding RuntimeText}">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="{DynamicResource GoodBrush}" IsVisible="{Binding RuntimeOnline}" />
            <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding RuntimeOffline}" />
            <TextBlock Text="{Binding RuntimeIndicatorText}" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button Grid.Column="7" Content="Refresh" Command="{Binding RefreshCommand}"
                ToolTip.Tip="Look again for games, headset software and mod profiles" />
        <Button Grid.Column="9" Content="Settings" Command="{Binding ShowSettingsPageCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">

      <!-- Library -->
      <ScrollViewer IsVisible="{Binding ShowLibrary}" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="28,24,28,24">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Text="Your library" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.4" />
              <TextBlock Classes="secondary" FontSize="15"
                         Text="Pick a game, then choose how to play: in VR, with mods, or as it shipped." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <Button Classes="chip" Classes.selected="{Binding IsFilterAll}" Content="{Binding FilterAllText}"
                      Command="{Binding SetLibraryFilterCommand}" CommandParameter="all" />
              <Button Classes="chip" Classes.selected="{Binding IsFilterInstalled}" Content="{Binding FilterInstalledText}"
                      Command="{Binding SetLibraryFilterCommand}" CommandParameter="installed" />
              <Button Classes="chip" Classes.selected="{Binding IsFilterReady}" Content="{Binding FilterReadyText}"
                      Command="{Binding SetLibraryFilterCommand}" CommandParameter="ready" />
            </StackPanel>
          </Grid>

          <Border Classes="card" Padding="18,14" IsVisible="{Binding ShowHeadsetHint}">
            <Grid ColumnDefinitions="Auto,14,*,14,Auto">
              <Path Width="24" Height="24" Stretch="None" VerticalAlignment="Center"
                    Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M3,9 a3,3 0 0 1 3,-3 h12 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-3 l-2,-3 h-2 l-2,3 h-3 a3,3 0 0 1 -3,-3 z" />
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Connect your headset to play in VR" FontWeight="SemiBold" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Start SteamVR or Virtual Desktop and put the headset on, then press Refresh. Monitor modes work without it." />
              </StackPanel>
              <Button Grid.Column="4" Classes="outline" Content="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding FilteredGames}" IsVisible="{Binding HasFilteredGames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItemViewModel">
                <Button Classes="game-card" Width="182" Margin="0,0,18,18"
                        ToolTip.Tip="Open this game"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGameCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <Border Height="273" Background="{Binding CoverBrush}" CornerRadius="9,9,0,0" ClipToBounds="True"
                            Opacity="{Binding CoverOpacity}">
                      <Grid>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                               IsVisible="{Binding HasCoverImage}" />
                        <Grid Margin="14" RowDefinitions="Auto,*,Auto"
                              IsVisible="{Binding !HasCoverImage}">
                          <TextBlock Text="{Binding EngineText}" Foreground="{DynamicResource CoverInkSecondaryBrush}"
                                     FontSize="10" FontWeight="SemiBold" LetterSpacing="1" />
                          <TextBlock Grid.Row="1" Classes="cover-mark" Text="{Binding CoverMark}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Border Grid.Row="2" Height="2" Background="{DynamicResource CoverInkBrush}" />
                        </Grid>
                      </Grid>
                    </Border>
                    <StackPanel Margin="14,12,14,14" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                 TextWrapping="Wrap" MaxLines="2" MinHeight="38" LineHeight="19" />
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" Fill="{Binding LibraryStatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LibraryStatusText}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card" IsVisible="{Binding !HasFilteredGames}" Padding="48">
            <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="460">
              <TextBlock Text="{Binding EmptyLibraryTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding EmptyLibraryText}" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="Show all games" Command="{Binding SetLibraryFilterCommand}" CommandParameter="all" />
                <Button Classes="primary" Content="Refresh library" Command="{Binding RefreshCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Game page -->
      <ScrollViewer x:Name="GameScroll" IsVisible="{Binding ShowGameDetail}" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid DataContext="{Binding SelectedGame}" ColumnDefinitions="260,32,*" Margin="28,24,28,24">

          <StackPanel Spacing="16">
            <StackPanel Spacing="8">
              <Button x:Name="GameStreamButton" Click="Streaming_Click"
                      Content="{Binding StreamButtonLabel}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44"
                      ToolTip.Tip="Connect OBS to stream or record this game's VR view" />
              <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Streaming.HasActiveOutput}"
                         Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Streaming.OutputText}" />
              <Button x:Name="GameModUpdateButton" IsVisible="{Binding HasPublicModUpdate}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UpdateGameModsCommand}"
                      IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanUpdateSelectedMods}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44"
                      BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentBrush}"
                      ToolTip.Tip="{Binding ModUpdateButtonHint}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="⟳" FontSize="20" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ModUpdateButtonText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <TextBlock Classes="secondary" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"
                         IsVisible="{Binding HasPublicModUpdate}" Text="This game's VR components only" />
            </StackPanel>
            <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Border Width="260" Height="390" Background="{Binding CoverBrush}" CornerRadius="10" ClipToBounds="True">
              <Grid>
                <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                       IsVisible="{Binding HasCoverImage}" />
                <Grid Margin="20" RowDefinitions="Auto,*,Auto"
                      IsVisible="{Binding !HasCoverImage}">
                  <TextBlock Text="{Binding EngineText}" Foreground="{DynamicResource CoverInkSecondaryBrush}"
                             FontSize="10" FontWeight="SemiBold" LetterSpacing="1" />
                  <TextBlock Grid.Row="1" Classes="cover-mark" Text="{Binding CoverMark}" FontSize="64"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Row="2" Height="2" Background="{DynamicResource CoverInkBrush}" />
                </Grid>
              </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16" IsVisible="{Binding HasModCredits}">
              <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="♡" Foreground="{DynamicResource AccentBrush}" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Text="MOD CREATORS" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ModCredits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="config:GameModCredit">
                    <Button Tag="{Binding Url}" Click="OpenExternalUrl_Click" Margin="0,0,0,14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            ToolTip.Tip="Open the mod creator's project">
                      <Grid ColumnDefinitions="34,10,*,22">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GroundBrush}"
                                VerticalAlignment="Top">
                          <TextBlock Text="{Binding CreatorInitial}" Foreground="{DynamicResource AccentBrush}"
                                     FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="5">
                          <TextBlock Text="{Binding Creator}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Project}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Role}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="↗" Classes="secondary" FontSize="15" VerticalAlignment="Top" Margin="6,0,0,0" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="STATUS" />
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="{Binding LibraryStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LibraryStatusText}" FontSize="13" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="INSTALLED AT" />
                  <TextBlock Text="{Binding InstallText}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

              </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="22">
            <StackPanel Spacing="6">
              <TextBlock Classes="secondary" Text="{Binding RouteText}" FontSize="14" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card" Padding="18,14" IsVisible="{Binding NotInstalled}">
              <Grid ColumnDefinitions="*,14,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="This game is not installed yet" FontWeight="SemiBold" />
                  <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding NotInstalledText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Content="Locate installed game" Click="LocateFriendslopGame_Click"
                          IsVisible="{Binding CanLocateGame}" />
                  <Button Classes="primary" Content="Open in Steam" Tag="{Binding SteamStoreUrl}"
                          Click="OpenExternalUrl_Click" IsVisible="{Binding HasStorePage}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasSetupCard}">
              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="VR SETUP" />
                <TextBlock Text="{Binding SetupTitle}" Foreground="{Binding SetupBrush}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SetupQuickStatus}" Classes="helpBody" />
                <ProgressBar IsVisible="{Binding SetupBusy}" IsIndeterminate="True" Height="5" />
                <TextBlock Classes="secondary" Text="{Binding SetupPackageStatus}" />
                <TextBlock Classes="secondary" Text="{Binding CyberpunkDependencyStatus}" IsVisible="{Binding IsCyberpunk}" />
                <TextBlock Classes="secondary" Text="{Binding SetupProfileStatus}" IsVisible="{Binding HasSetupProfileStatus}" />
                <TextBlock Classes="secondary" Text="{Binding SetupRuntimeStatus}" IsVisible="{Binding ShowSetupRuntimeStatus}" />
                <WrapPanel>
                  <Button Classes="primary" Content="{Binding PrepareText}" Margin="0,0,10,8"
                          IsVisible="{Binding SetupCanInstall}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PrepareCommand}" />
                  <Button Content="Import VR profile ZIP" Margin="0,0,10,8" Click="ImportUevrProfile_Click"
                          IsVisible="{Binding SetupNeedsProfileImport}" />
                  <Button Content="View setup help" Margin="0,0,10,8" Click="OpenSetupHelp_Click"
                          IsVisible="{Binding SetupNeedsDetails}" />
                  <Button Content="Set up New Vegas VR and Vortex sync" Margin="0,0,10,8"
                          Click="OpenFalloutNewVegasSetup_Click" IsVisible="{Binding CanConfigureFalloutNewVegas}" />
                  <Button Classes="primary" Content="Install VR" Margin="0,0,10,0"
                          IsVisible="{Binding CyberpunkCanInstall}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PrepareCommand}" />
                  <Button Classes="primary" Content="Authorize Nexus download" Margin="0,0,10,0"
                          IsVisible="{Binding CyberpunkCanAuthorize}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InstallCyberpunkRequirementsCommand}" />
                  <Button Content="Pause setup" IsVisible="{Binding CyberpunkSetupBusy}"
                          IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsInstallingCyberpunkRequirements}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelCyberpunkRequirementsCommand}" />
                  <Button Content="Recheck setup" Margin="0,0,0,8" IsVisible="{Binding !SetupBusy}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RecheckGameSetupCommand}" />
                  <Button Content="Troubleshooting: start here" Margin="10,0,0,8" Click="OpenTroubleshooting_Click" />
                </WrapPanel>
                <Expander Header="Setup details" HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding SetupStatus}" Classes="helpBody" Margin="0,10,0,0" />
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="GAME COMPATIBILITY" />
                <TextBlock Text="{Binding CompatibilityQuickText}" Classes="helpBody" />
                <TextBlock Classes="secondary" Text="{Binding BuildIdentityText}" TextWrapping="Wrap" FontSize="12" />
                <Button Content="Use a compatible game version" IsVisible="{Binding CanRecoverGameVersion}"
                        HorizontalAlignment="Left" Click="RecoverGameVersion_Click"
                        AutomationProperties.AutomationId="RecoverGameVersion" />
                <Expander Header="Game versions and automatic VR updates" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="10" Margin="0,10,0,0">
                    <TextBlock Text="Installation to use" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding InstallationChoices}" SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CompatibleInstallationSelector">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstallationChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Choose another / older game installation" Click="ChooseCompatibleInstallation_Click"
                            HorizontalAlignment="Left" AutomationProperties.AutomationId="ChooseCompatibleInstallation" />
                  <TextBlock Text="! Back up saves before switching game versions. Newer saves may not load in older games."
                             Foreground="{DynamicResource HelpWarningBrush}" Classes="helpBody" />
                  <TextBlock Classes="helpBody" Text="Choose a version offered by your store, or select a compatible copy you already own." />
                    <CheckBox Content="Automatically prepare approved VR package updates before VR play"
                              IsChecked="{Binding AutomaticCompatibilityUpdates, Mode=TwoWay}" IsEnabled="{Binding CanUseCompatibility}" />
                    <WrapPanel>
                      <Button Content="Prepare approved VR package" Margin="0,0,8,8"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PrepareCompatibleVrCommand}" />
                      <Button Content="Clean monitor play" Margin="0,0,8,8"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CleanMonitorCommand}" />
                      <Button Content="Restore parked mods" Margin="0,0,8,8" IsVisible="{Binding HasParkedMods}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RestoreParkedModsCommand}" />
                      <Button Content="Restore previous VR package" Margin="0,0,8,8" IsVisible="{Binding HasPackageBackup}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RollBackVrPackageCommand}" />
                    </WrapPanel>
                  <Expander Header="How versions, backups and monitor play work" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                      <TextBlock Text="{Binding CompatibilityText}" Classes="helpBody" />
                      <TextBlock Text="{Binding SaveCompatibilityWarning}" Classes="helpBody" />
                      <TextBlock Text="Clean monitor play parks detected mod loaders and deployed mods. Backups stay in the selected game folder. Changes to original game files may need Steam verification or a clean copy." Classes="helpBody" />
                      <TextBlock Text="AVRcade does not download old game binaries. Your store still controls access and sign-in." Classes="helpBody" />
                    </StackPanel>
                  </Expander>
                    <Button Content="I tested stereo, tracking and controls in this build" HorizontalAlignment="Left"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConfirmCompatibleHeadsetTestCommand}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <!-- The four ways to play: the same block on every game. -->
            <StackPanel Spacing="12" IsVisible="{Binding HasPlayModes}">
              <TextBlock Classes="eyebrow" Text="CHOOSE HOW TO PLAY" />
              <ItemsControl ItemsSource="{Binding PlayModes}" Margin="-7">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlayModeViewModel">
                    <Border Classes="card" Margin="7">
                      <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Path Width="24" Height="24" Stretch="None" Data="{Binding Icon}"
                                Stroke="{Binding IconBrush}" StrokeThickness="1.8"
                                StrokeLineCap="Round" StrokeJoin="Round" />
                          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap"
                                   FontSize="14" MinHeight="40" />
                        <Grid ColumnDefinitions="Auto,8,*" MinHeight="36">
                          <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                        <Button Classes="play" Classes.primary="{Binding IsVrLaunch}" Classes.strong="{Binding IsFlatLaunch}"
                                Classes.outline="{Binding IsSetup}"
                                Content="{Binding ActionText}" IsEnabled="{Binding CanAct}"
                                Tag="{Binding}" Click="PlayMode_Click" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Deferred engines keep their experimental panels; their games are not
                 listed in the catalogue yet. -->
            <Border Classes="card" IsVisible="{Binding IsFalloutNewVegas}">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="Fallout: New Vegas launch options" />
                <Button Classes="primary" Content="Native VR — experimental" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchFalloutNewVegasNativeCommand}"
                        IsVisible="{Binding CanLaunchFalloutNewVegas}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Native OpenXR stereo without the Vortex profile. This route refuses detectable Vortex deployment or extra physical plugins; manually installed loose files cannot be ruled out." />
                <Button Classes="primary" Content="VR with Vortex mods — experimental" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchFalloutNewVegasVortexCommand}"
                        IsVisible="{Binding CanLaunchFalloutNewVegas}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="First deploy New Vegas mods in Vortex and apply the one-way sync in VR setup. AVRcade then checks readiness and launches the isolated MO2 VR profile; Vortex still owns its deployed files." />
                <Button Content="Set up New Vegas VR and Vortex sync" HorizontalAlignment="Left"
                        Click="OpenFalloutNewVegasSetup_Click" IsVisible="{Binding CanConfigureFalloutNewVegas}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="For flat play with your Vortex profile and no VR, use Play in Vortex." />
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding IsFallout3}">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="Fallout 3 launch options" />
                <Button Classes="primary" Content="Native VR — experimental" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchFallout3NativeCommand}"
                        IsVisible="{Binding CanLaunchFallout3}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Launches FOSE with VR enabled. It sees the installed game files, including any Vortex mods already deployed there." />
                <Button Classes="primary" Content="VR with Vortex mods — experimental" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchFallout3VortexCommand}"
                        IsVisible="{Binding CanLaunchFallout3}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="First select a Fallout 3 profile and Deploy Mods in Vortex. This launch checks that Vortex is available, then uses the same FOSE VR path; it cannot verify which profile was deployed." />
                <Button Content="Desktop with deployed mods — VR off" HorizontalAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchFallout3DesktopCommand}"
                        IsVisible="{Binding CanLaunchFallout3Desktop}" />
                <Button Content="Manage Fallout 3 mods in Vortex" HorizontalAlignment="Left"
                        Click="OpenFallout3Vortex_Click" />
              </StackPanel>
            </Border>

            <!-- Everything behind the four buttons, one topic per tab. -->
            <Border Classes="card" Padding="6,2,6,6">
              <TabControl SelectedIndex="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DetailTabIndex, Mode=TwoWay}">

                <TabItem Header="VR setup">
                  <StackPanel Spacing="16" Margin="6,14,6,8">
                    <Expander x:Name="SetupRecovery" Header="Step-by-step setup help"
                              IsVisible="{Binding HasSetupHelp}" IsExpanded="False" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="12" Margin="0,10,0,0">
                        <TextBlock Text="→ Follow these steps in order. Stop when setup is complete." Foreground="{DynamicResource HelpActionBrush}" Classes="helpBody" />
                        <ItemsControl ItemsSource="{Binding NumberedSetupSteps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HelpInstruction">
                              <Grid ColumnDefinitions="30,*" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{DynamicResource HelpActionBrush}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="helpBody" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                          <Button Content="{Binding UevrProfileImportText}" Click="ImportUevrProfile_Click"
                                  Margin="0,0,10,8" IsVisible="{Binding SetupCanImportProfile}" />
                          <Button Content="View profile source" Tag="{Binding UevrProfileSourceUrl}"
                                  Click="OpenExternalUrl_Click" Margin="0,0,10,8" IsVisible="{Binding CanImportUevrProfile}" />
                          <Button Content="View package setup source" Tag="{Binding SetupSourceUrl}"
                                  Click="OpenExternalUrl_Click" Margin="0,0,10,8" IsVisible="{Binding HasSetupSource}" />
                        </WrapPanel>
                        <TextBlock Classes="secondary" Text="{Binding UevrProfileStatusText}" TextWrapping="Wrap"
                                   IsVisible="{Binding CanImportUevrProfile}" />
                        <ItemsControl ItemsSource="{Binding SetupSteps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStepViewModel">
                              <StackPanel Spacing="4" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>

                    <Border Classes="inset" IsVisible="{Binding HasModded}">
                      <StackPanel DataContext="{Binding Modded}" x:DataType="vm:ModdedGameViewModel" Spacing="6">
                        <TextBlock Classes="secondary" Text="{Binding ManagedInstallLocationText}" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" Text="{Binding SteamVrNoticeText}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasSteamVrNotice}" />
                        <TextBlock Classes="secondary" Text="{Binding Warning}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="inset" IsVisible="{Binding ShowStandaloneRuntimeNotice}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding RuntimeNoticeTitle}" FontWeight="SemiBold" />
                        <TextBlock Classes="secondary" Text="{Binding RuntimeNoticeText}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Border Classes="inset" IsVisible="{Binding IsCyberpunk}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="About the Cyberpunk 2077 VR backend" FontWeight="SemiBold" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding CyberpunkBackendNoteText}" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding CyberpunkBackendCareText}" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding CyberpunkRequirementsText}" />
                      </StackPanel>
                    </Border>

                    <Expander Header="Manual installation if download detection fails"
                              IsVisible="{Binding IsCyberpunk}" IsExpanded="False"
                              HorizontalAlignment="Stretch">
                      <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="The VR port downloads directly. Automatic ZIP detection is only for More Occluders Scripted v0.3. While setup is running, AVRcade checks your configured Downloads folder and Vortex's default Cyberpunk download folder once per second for up to 10 minutes. It does not search other folders or scan the whole PC."
                                   Classes="secondary" TextWrapping="Wrap" />
                        <TextBlock Text="1. Close Cyberpunk 2077. If automatic setup is still waiting, choose Pause setup at the top first."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="2. Download More Occluders (Scripted), version 0.3, using the link below. Keep the ZIP and its original filename; do not extract it or copy files into the game folder. The ArchiveXL version is a different package."
                                   TextWrapping="Wrap" />
                        <Button Content="Download More Occluders Scripted v0.3" HorizontalAlignment="Left"
                                Click="OpenCyberpunkRequirementDownload_Click" />
                        <TextBlock Text="3. If Install VR is shown at the top, install the VR port first. Then choose the downloaded ZIP below, wherever you saved it. AVRcade validates the archive and installs its scripts in the Cyberpunk-only managed package."
                                   TextWrapping="Wrap" />
                        <Button Content="Choose downloaded ZIP and install" HorizontalAlignment="Left"
                                Click="ImportCyberpunkRequirementZip_Click" />
                        <TextBlock Text="4. The top status changes to VR setup complete when both packages are installed. If import fails, the reason appears there. Nothing needs to be placed manually; this keeps VR files separate from monitor play."
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>



                    <Border Classes="inset" IsVisible="{Binding IsRvThereYet}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Controller-driven hands (experimental)" FontWeight="SemiBold" />
                        <TextBlock Classes="secondary" Text="{Binding RvHandsStatusText}" TextWrapping="Wrap" />
                        <Button Content="{Binding RvHandsButtonText}" HorizontalAlignment="Left"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleRvHandsCommand}" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13"
                                   Text="Local first-person avatar only; this does not add finger tracking, physical grabbing, or networked hands." />
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,14,Auto" IsVisible="{Binding CanUninstall}">
                      <TextBlock Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"
                                 Text="Want the untouched game folder back? Removing the VR mod deletes only the files AVRcade added." />
                      <Button Grid.Column="2" Classes="danger" Content="Remove VR mod" Click="Uninstall_Click" />
                    </Grid>
                  </StackPanel>
                </TabItem>

                <TabItem Header="Mods">
                  <StackPanel Spacing="16" Margin="6,14,6,8">

                    <!-- Unity games: profiles in r2modman, Thunderstore Mod Manager or Vortex -->
                    <StackPanel IsVisible="{Binding HasModded}">
                      <StackPanel DataContext="{Binding Modded}" x:DataType="vm:ModdedGameViewModel" Spacing="16">
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Mods live in your mod manager, not in AVRcade. Keep two profiles there: one with the VR mod for VR + mods, one without it for Mods, no VR. Then pick them here." />

                        <StackPanel Spacing="8">
                          <TextBlock Classes="heading" Text="1. Your mod manager" />
                          <TextBlock Classes="secondary" Text="{Binding InstalledManagersText}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasInstalledManagers}">
                            <ComboBox ItemsSource="{Binding InstalledManagers}" MinHeight="40" Width="260"
                                      SelectedItem="{Binding SelectedManager, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mod:ModManagerInstall">
                                  <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="outline" Content="Open mod manager" Click="OpenFriendslopManager_Click" />
                            <Button Content="Reread profiles"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RefreshCommand}" />
                          </StackPanel>
                          <!-- Download links are only offered while no manager is found. -->
                          <WrapPanel>
                            <Button Content="Get r2modman" Margin="0,0,10,8" Tag="https://github.com/ebkr/r2modmanPlus/releases" Click="OpenExternalUrl_Click"
                                    IsVisible="{Binding NoInstalledManagers}" />
                            <Button Content="Get Thunderstore Mod Manager" Margin="0,0,10,8" Tag="https://www.overwolf.com/apps/mods-managers" Click="OpenExternalUrl_Click"
                                    IsVisible="{Binding NoInstalledManagers}" />
                            <Button Content="Get Vortex" Margin="0,0,10,8" Tag="https://www.nexusmods.com/site/about/vortex" Click="OpenExternalUrl_Click"
                                    IsVisible="{Binding NoInstalledManagers}" />
                            <Button Content="{Binding LocateManagerText}" Margin="0,0,10,8" Click="LocateModManager_Click" />
                            <Button Content="Check again" Margin="0,0,10,8" IsVisible="{Binding NoInstalledManagers}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RefreshCommand}" />
                          </WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                          <TextBlock Classes="heading" Text="2. Profile for VR + mods" />
                          <TextBlock Classes="secondary" Text="{Binding VrModIdentityText}" TextWrapping="Wrap"
                                     IsVisible="{Binding NeedsVrProfileHelp}" />
                          <TextBlock Classes="secondary" Text="{Binding VrWithModsManagerInstructions}" TextWrapping="Wrap"
                                     IsVisible="{Binding NeedsVrProfileHelp}" />
                          <TextBlock Text="No profiles found for this game yet. Create one in your mod manager, then press Reread profiles."
                                     TextWrapping="Wrap" FontSize="13" IsVisible="{Binding NoProfiles}" />
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                      IsVisible="{Binding HasProfiles}"
                                      PlaceholderText="Choose a profile with the VR mod" MinHeight="40" Width="340">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mod:ModManagerProfile">
                                  <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Clear" IsVisible="{Binding HasSelectedProfile}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearVrProfileCommand}" />
                            <Button Content="VR mod page" Tag="{Binding OriginalPageUrl}" Click="OpenExternalUrl_Click" />
                          </StackPanel>
                          <TextBlock Text="{Binding VrProfileStatusText}" TextWrapping="Wrap" FontSize="13"
                                     IsVisible="{Binding HasProfiles}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                          <TextBlock Classes="heading" Text="3. Profile for Mods, no VR" />
                          <TextBlock Classes="secondary" Text="{Binding FlatModeInstructions}" TextWrapping="Wrap"
                                     IsVisible="{Binding NeedsFlatProfileHelp}" />
                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasProfiles}">
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedFlatProfile, Mode=TwoWay}"
                                      PlaceholderText="Choose a profile without the VR mod" MinHeight="40" Width="340">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mod:ModManagerProfile">
                                  <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Clear" IsVisible="{Binding HasSelectedFlatProfile}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearFlatProfileCommand}" />
                          </StackPanel>
                          <TextBlock Text="{Binding FlatProfileStatusText}" TextWrapping="Wrap" FontSize="13"
                                     IsVisible="{Binding HasProfiles}" />
                        </StackPanel>

                        <TextBlock Classes="secondary" Text="{Binding GameDirectoryConflictText}" FontSize="13"
                                   TextWrapping="Wrap" IsVisible="{Binding HasGameDirectoryConflict}" />

                        <Expander Header="Advanced: profile contents, launch arguments, moved data folders" IsExpanded="False">
                          <StackPanel Spacing="10" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <Border Width="64" Height="64" Background="{DynamicResource GroundBrush}" CornerRadius="8">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
                              </Border>
                              <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="560">
                                <TextBlock Text="{Binding CreatorText}" FontWeight="SemiBold" />
                                <TextBlock Classes="secondary" Text="{Binding Summary}" TextWrapping="Wrap" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="Packages the VR mod depends on (reference list; the manager resolves current versions):" />
                            <TextBlock Text="{Binding DependenciesText}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="Mods in the VR profile (read only)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VrModsText}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="Mods in the flat profile (read only)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FlatModsText}" TextWrapping="Wrap" FontSize="13" />
                            <StackPanel IsVisible="{Binding IsR2Profile}" Spacing="8">
                              <TextBlock Text="Custom r2modman launch arguments (optional)" FontWeight="SemiBold" />
                              <TextBlock Classes="secondary" TextWrapping="Wrap"
                                         Text="AVRcade builds the standard arguments from the profile's mod loader. Only paste your own if the game needs them." />
                              <TextBox Text="{Binding R2LaunchArguments, Mode=TwoWay}" Watermark="Leave blank for automatic launch" TextWrapping="Wrap" />
                              <Button Content="Save launch arguments" HorizontalAlignment="Left"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveManagerLaunchArgumentsCommand}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding CanFindMovedProfiles}" Spacing="8">
                              <TextBlock Text="Moved a manager's data folder?" FontWeight="SemiBold" />
                              <TextBlock Classes="secondary" TextWrapping="Wrap"
                                         Text="Choose the manager and enter its data folder from the manager's settings. AVRcade only reads it." />
                              <ComboBox ItemsSource="{Binding ManagersWithDataRoots}" SelectedItem="{Binding ManagerForMovedProfiles, Mode=TwoWay}"
                                        MinWidth="260" MinHeight="40" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="mod:ModManagerInstall"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBox Text="{Binding MovedProfileRoot, Mode=TwoWay}" Watermark="Manager data folder" />
                              <Button Content="Use this data folder" HorizontalAlignment="Left"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveMovedProfileRootCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </StackPanel>

                    <!-- Cyberpunk 2077 and Unreal games: mods deployed into the game folder -->
                    <StackPanel Spacing="12" IsVisible="{Binding UsesFolderMods}">
                      <StackPanel Spacing="6" IsVisible="{Binding IsCyberpunk}">
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Hold both stick clicks for one second, or press F10, to open the mod's VR settings. HUD, frame generation, driving and controller bindings are configured there." />
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Installed only for Cyberpunk 2077 VR." />
                      </StackPanel>
                      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="This game loads mods from its game folder. Deploy your mods with your mod manager before launching." />
                      <TextBlock Classes="heading" Text="Your mod manager" />
                      <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GameModManagerText}"
                                 Classes="secondary" TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button Classes="outline" Content="Open mod manager" Margin="0,0,10,8"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGameModManagerCommand}"
                                IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanOpenGameModManager}" />
                        <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GameManagerChooserText}"
                                Margin="0,0,10,8" Click="SelectGameModManager_Click" />
                        <Button Content="Open game folder" Margin="0,0,10,8"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGameFolderCommand}" />
                        <Button Content="Manage mods in Vortex inside AVRcade" Margin="0,0,10,8"
                                Click="OpenCyberpunkVortex_Click" IsVisible="{Binding IsCyberpunk}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding UnrealModsText}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUnreal}" />
                      <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsUnreal}"
                                 Text="Unreal has no per-launch switch for game-folder mods. VR + mods can open a selected manager even with an empty profile; AVRcade waits for the game and then attaches UEVR. Refresh after changing mods." />
                      <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsCyberpunk}"
                                 Text="The two modded modes start the game with REDmod's -modded argument. Mods copied straight into the archive folder load in every mode; AVRcade cannot verify which mods were deployed or that each one works in VR." />
                      <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsCyberpunkRedmodMissing}"
                                 Text="REDmod is not installed. Add the Cyberpunk 2077 REDmod DLC in Steam to use REDmod-packaged mods." />
                    </StackPanel>

                    <!-- GTA San Andreas: mods edit the shared game folder -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsGtaSanAndreas}">
                      <TextBlock Classes="secondary" TextWrapping="Wrap"
                                 Text="San Andreas mods are installed into the game folder itself. Use any manager you like to add them, then launch from AVRcade so the VR bridge and headset settings apply." />
                      <TextBlock Classes="heading" Text="Your mod manager" />
                      <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GtaModManagerText}"
                                 Classes="secondary" TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button Classes="outline" Content="Open mod manager" Margin="0,0,10,8"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGtaSanAndreasModManagerCommand}" />
                        <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GtaManagerChooserText}"
                                Margin="0,0,10,8" Click="SelectGtaModManager_Click" />
                        <Button Content="Get GGMM" Margin="0,0,10,8" Tag="https://www.gtagarage.com/mods/show.php?id=434" Click="OpenExternalUrl_Click"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowGtaManagerDownloads}" />
                        <Button Content="Get SAMI" Margin="0,0,10,8" Tag="https://www.gtainside.com/sanandreas/tools/5604-san-andreas-mod-installer/" Click="OpenExternalUrl_Click"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowGtaManagerDownloads}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GtaVrGameFolderText}"
                                 TextWrapping="Wrap" FontSize="13" />
                      <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13"
                                 Text="GGMM needs ggmm.exe and gtainterface.dll beside gta_sa.exe; for SAMI choose the installed sami.exe, not its setup file. VR only switches ModLoader add-ons off for that launch; mods copied over game files load in every mode." />
                      <TextBlock Classes="heading" Text="Clean folder for Vanilla" />
                      <TextBlock Classes="secondary" TextWrapping="Wrap"
                                 Text="Mods written into game files cannot be switched off, so Vanilla plays a separate, unmodded copy of the game. Choose it once." />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GtaCleanFolderChooserText}"
                                Click="SelectGtaVanillaFolder_Click" />
                      </StackPanel>
                      <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GtaVanillaFolderText}"
                                 TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                  </StackPanel>
                </TabItem>

                <TabItem Header="Controls">
                  <StackPanel Spacing="16" Margin="6,14,6,8">

                    <StackPanel Spacing="10" IsVisible="{Binding IsCyberpunk}">
                      <TextBlock Classes="heading" Text="VR turning" />
                      <Border Classes="inset">
                        <StackPanel Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Snap" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding IsCyberpunkSmoothTurn, Mode=OneWay}" OnContent="" OffContent=""
                                          CommandParameter="toggle"
                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkTurnModeCommand}" />
                            <TextBlock Text="Smooth" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Spacing="6" IsVisible="{Binding IsCyberpunkSnapTurn}">
                            <TextBlock Text="{Binding CyberpunkSnapAngleText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="15°" CommandParameter="15"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkSnapTurnAngleCommand}" />
                              <Button Content="30°" CommandParameter="30"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkSnapTurnAngleCommand}" />
                              <Button Content="45°" CommandParameter="45"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkSnapTurnAngleCommand}" />
                              <Button Content="60°" CommandParameter="60"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkSnapTurnAngleCommand}" />
                              <Button Content="90°" CommandParameter="90"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetCyberpunkSnapTurnAngleCommand}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Classes="secondary" IsVisible="{Binding IsCyberpunkSmoothTurn}"
                                     TextWrapping="Wrap" Text="Smooth turn speed follows Cyberpunk's controller sensitivity." />
                          <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13"
                                     Text="Right stick turns; headset tracking stays smooth. Applies to both VR modes." />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding HasHudModes}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="heading" Text="VR HUD" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding HudModeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Compact"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetHudModeCommand}"
                                CommandParameter="Compact" />
                        <Button Content="Comfortable"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetHudModeCommand}"
                                CommandParameter="Comfortable" />
                        <Button Content="Hide HUD"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetHudModeCommand}"
                                CommandParameter="Hidden" />
                      </StackPanel>
                      <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap"
                                 Text="Changes VR gameplay only. Monitor play and Cyberpunk's pause, inventory and map screens are left alone." />
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsGtaSanAndreas}">
                      <TextBlock Classes="heading" Text="VR turning" />
                      <Border Classes="inset">
                        <StackPanel Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Snap" VerticalAlignment="Center" />
                            <ToggleSwitch IsChecked="{Binding IsGtaSmoothTurn, Mode=OneWay}" OnContent="" OffContent=""
                                          CommandParameter="toggle"
                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaTurnModeCommand}" />
                            <TextBlock Text="Smooth" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Spacing="6" IsVisible="{Binding IsGtaSnapTurn}">
                            <TextBlock Text="{Binding GtaSnapAngleText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="15°" CommandParameter="15"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSnapTurnAngleCommand}" />
                              <Button Content="30°" CommandParameter="30"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSnapTurnAngleCommand}" />
                              <Button Content="45°" CommandParameter="45"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSnapTurnAngleCommand}" />
                              <Button Content="60°" CommandParameter="60"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSnapTurnAngleCommand}" />
                              <Button Content="90°" CommandParameter="90"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSnapTurnAngleCommand}" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Spacing="6" IsVisible="{Binding IsGtaSmoothTurn}">
                            <TextBlock Text="{Binding GtaSmoothSpeedText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="45°/s" CommandParameter="45"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSmoothTurnSpeedCommand}" />
                              <Button Content="90°/s" CommandParameter="90"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSmoothTurnSpeedCommand}" />
                              <Button Content="135°/s" CommandParameter="135"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSmoothTurnSpeedCommand}" />
                              <Button Content="180°/s" CommandParameter="180"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetGtaSmoothTurnSpeedCommand}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13"
                                     Text="Snap turns by the chosen angle on each right-stick push; Smooth turns while held. Applies to both VR modes on the next launch." />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding NoControllerReference}"
                               Text="No controller map for this game yet. The VR conversion's own page lists its controls." />

                    <StackPanel Spacing="14" IsVisible="{Binding HasControllerReference}">
                      <TextBlock Classes="heading" Text="{Binding ControllerReferenceTitle}" />
                      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ControllerGuidance}" />
                      <TabControl ItemsSource="{Binding ControllerDevices}" SelectedItem="{Binding SelectedController, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ControllerEditorViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                          <DataTemplate x:DataType="vm:ControllerEditorViewModel">
                            <StackPanel Spacing="14" Margin="0,14,0,8">
                              <views:ControllerDiagram />
                            </StackPanel>
                          </DataTemplate>
                        </TabControl.ContentTemplate>
                      </TabControl>
                    </StackPanel>
                  </StackPanel>
                </TabItem>

                <TabItem Header="About">
                  <StackPanel Spacing="16" Margin="6,14,6,8">
                    <Grid ColumnDefinitions="140,16,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto">
                      <TextBlock Classes="secondary" Text="VR status" />
                      <StackPanel Grid.Column="2" Spacing="4">
                        <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource GroundBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding ReadinessDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Classes="secondary" Text="Play safely" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SafetyText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="4" Classes="secondary" Text="How it works" />
                      <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding RouteText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="6" Classes="secondary" Text="Installed at" />
                      <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding InstallText}" TextWrapping="Wrap" />
                    </Grid>

                  </StackPanel>
                </TabItem>

                <TabItem Header="Troubleshooting">
                  <StackPanel Spacing="16" Margin="6,14,6,8" MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}">
                    <TextBlock x:Name="TroubleshootingStart" Text="{Binding DisplayName, StringFormat='Start here: {0}'}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Follow one highlighted step. Check again after making a change." Classes="helpBody" />
                    <WrapPanel>
                      <TextBlock Text="→ Next step" Foreground="{DynamicResource HelpActionBrush}" FontWeight="SemiBold" Margin="0,0,18,8" />
                      <TextBlock Text="! Check needed" Foreground="{DynamicResource HelpWarningBrush}" FontWeight="SemiBold" Margin="0,0,18,8" />
                      <TextBlock Text="✓ Check passed" Foreground="{DynamicResource HelpSuccessBrush}" FontWeight="SemiBold" Margin="0,0,18,8" />
                      <TextBlock Text="■ VR blocked" Foreground="{DynamicResource HelpStopBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    </WrapPanel>
                    <ContentControl Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.Next}"
                                    ContentTemplate="{StaticResource TroubleshootingCardTemplate}" />
                    <Button Content="Check this game again" HorizontalAlignment="Left"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunGameDiagnosticsCommand}" />
                    <Expander Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.OtherChecksLabel}"
                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.HasOtherChecks}" HorizontalAlignment="Stretch">
                      <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.OtherChecks}"
                                    ItemTemplate="{StaticResource TroubleshootingCardTemplate}" />
                    </Expander>
                    <Expander Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.PassedChecksLabel}"
                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.HasPassedChecks}" HorizontalAlignment="Stretch">
                      <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingGuide.PassedChecks}"
                                    ItemTemplate="{StaticResource TroubleshootingCardTemplate}" />
                    </Expander>
                    <Expander Header="More repair options" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="14" Margin="0,12,0,0">
                        <TextBlock Text="! Close the game before repairing files." Foreground="{DynamicResource HelpWarningBrush}" Classes="helpBody" />
                        <TextBlock Text="Repair setup: recover an interrupted VR update and restore saved controller routes. Your preferences are kept." Classes="helpBody" />
                        <Button Content="Repair setup" HorizontalAlignment="Left"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RecheckGameSetupCommand}" />
                        <TextBlock Text="Steam file check: restore missing or damaged original game files. Wait for Steam to finish, then check again." Classes="helpBody" />
                        <TextBlock Text="! Steam verification does not downgrade the game or fix incompatible mods." Foreground="{DynamicResource HelpWarningBrush}" Classes="helpBody" />
                        <Button x:Name="VerifyGameFilesButton" Content="Verify game files in Steam" HorizontalAlignment="Left"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VerifyGameFilesCommand}" />
                        <TextBlock Text="Install or locate the game first." Classes="helpBody" IsVisible="{Binding NotInstalled}" />
                      </StackPanel>
                    </Expander>
                    <Expander x:Name="TroubleshootingTechnical" Header="Technical details and latest action" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock Text="These results apply only to this game's selected folder. Check results stay in memory until AVRcade closes." Classes="helpBody" />
                        <TextBlock x:Name="TroubleshootingSummary" Classes="helpBody"
                                   Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingSummary}" />
                        <TextBlock Text="Latest app message" FontWeight="SemiBold" />
                        <TextBlock Classes="helpBody" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StatusText}" />
                        <TextBlock Classes="helpBody" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingActionStatus}" />
                        <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TroubleshootingFindings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="launch:TroubleshootingFinding">
                              <StackPanel Spacing="8" Margin="0,8,0,12">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Classes="helpBody" />
                                <TextBlock Text="{Binding Instructions}" Classes="helpBody" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </TabItem>
              </TabControl>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Settings -->
      <ScrollViewer IsVisible="{Binding ShowSettings}" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left" Margin="28,24,28,24">
          <StackPanel Spacing="6">
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.4" />
            <TextBlock Classes="secondary" FontSize="15" Text="Headset connection and how AVRcade looks." />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="HEADSET" />
              <TextBlock Text="{Binding RuntimeIndicatorText}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" Text="{Binding RuntimeText}" TextWrapping="Wrap" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="13"
                         Text="AVRcade looks for SteamVR and Virtual Desktop. If both run, VR games are sent to SteamVR, because its compositor owns the headset display. Other OpenXR runtimes still work for games that use the system default." />
              <Button Content="Check again" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Classes="eyebrow" Text="APPEARANCE" />
                  <TextBlock Text="{Binding ThemePaletteText}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ThemeModeText}" Command="{Binding ToggleThemeCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ThemePalettes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:LauncherPalette">
                    <Button Content="{Binding Name}" ToolTip.Tip="{Binding Description}" MinWidth="120" Margin="0,0,10,10"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPaletteCommand}"
                            CommandParameter="{Binding Id}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Expander Header="Diagnostics">
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <TextBlock Text="{Binding ReleaseToolingText}" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" Text="{Binding ReleaseToolingDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status line -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,10">
      <Grid ColumnDefinitions="*,16,Auto,16,Auto">
        <TextBlock x:Name="LaunchStatusText" Classes="secondary" Classes.launchSuccess="{Binding StatusSuccess}"
                   Text="{Binding StatusText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusText}" FontSize="13" VerticalAlignment="Center">
          <TextBlock.Styles>
            <Style Selector="TextBlock.launchSuccess">
              <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>
        <Button Grid.Column="2" Content="Full message" Click="OpenTroubleshootingDetails_Click" IsVisible="{Binding ShowGameDetail}" />
        <ProgressBar Grid.Column="4" Width="120" Height="4" IsIndeterminate="True" IsVisible="{Binding Busy}" />
      </Grid>
    </Border>
  </Grid>
</Window>

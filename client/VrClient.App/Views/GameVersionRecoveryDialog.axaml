<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="clr-namespace:VrClient.Core.Compatibility;assembly=VrClient.Core"
        x:Class="VrClient.App.Views.GameVersionRecoveryDialog" x:DataType="compat:GameVersionRecovery"
        Width="680" MaxHeight="740" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Title="Choose a compatible game version"
        Background="{DynamicResource GroundBrush}" Foreground="{DynamicResource InkBrush}">
  <Border Margin="20" Padding="20" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <TextBlock Text="■ VR BLOCKED" Foreground="{DynamicResource HelpStopBrush}" FontWeight="Bold" />
        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Spacing="6">
          <TextBlock Text="Installed game build" Classes="secondary" />
          <TextBlock Text="{Binding InstalledBuild}" FontSize="19" />
          <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
        <Border Background="{DynamicResource GroundBrush}" Padding="12" CornerRadius="6" BorderBrush="{DynamicResource HelpWarningBrush}" BorderThickness="3,0,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="! Back up saves first" Foreground="{DynamicResource HelpWarningBrush}" FontWeight="Bold" />
            <TextBlock Text="Newer saves may not load in an older game version." Classes="helpBody" />
          </StackPanel>
        </Border>
        <TextBlock Text="1. Open the game's properties in Steam." Foreground="{DynamicResource HelpActionBrush}" Classes="helpBody" />
        <Button Content="Open Steam game properties" IsVisible="{Binding HasSteamOptions}"
                Click="OpenSteam_Click" HorizontalAlignment="Left" Classes="helpAction"
                AutomationProperties.AutomationId="OpenStoreVersionOptions" />
        <TextBlock Text="2. Open Game Versions &amp; Betas. Choose a version listed above, if offered." Classes="helpBody" />
        <TextBlock Text="3. Wait for Steam to finish. Return here and recheck." Classes="helpBody" />
        <TextBlock Text="! A separate copy is selected. Steam may change a different folder." IsVisible="{Binding SeparateInstallation}"
                   Foreground="{DynamicResource HelpWarningBrush}" Classes="helpBody" />
        <WrapPanel>
          <Button Content="Recheck this installation" Click="Recheck_Click" Margin="0,0,8,8" />
          <Button Content="Close" Click="Cancel_Click" Margin="0,0,0,8" />
        </WrapPanel>
        <Expander Header="Other choices" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10" Margin="0,10,0,0">
            <TextBlock Text="If the store does not offer a compatible version:" Classes="helpBody" />
            <Button Content="Choose an existing compatible copy" Click="ChooseInstallation_Click" HorizontalAlignment="Left" />
            <Button Content="Clean monitor play" Click="Monitor_Click" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
        <Expander Header="More details" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12" Margin="0,10,0,0">
            <TextBlock Text="{Binding StoreInstructions}" Classes="helpBody" />
            <TextBlock Text="{Binding InstallationNote}" Classes="helpBody" />
            <TextBlock Text="{Binding SaveWarning}" Classes="helpBody" />
            <TextBlock Text="VR stays blocked until the selected copy passes compatibility checks." Classes="helpBody" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
